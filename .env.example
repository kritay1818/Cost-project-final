# MongoDB Atlas connection string (same database for all services)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# Optional log level for pino (trace, debug, info, warn, error)
LOG_LEVEL=info

# Service ports (defaults shown)
LOGS_PORT=3001
USERS_PORT=3002
COSTS_PORT=3003
ABOUT_PORT=3004

# Optional: override team list for about-service (JSON array)
# TEAM_MEMBERS=[{"first_name":"Itai","last_name":"Kritmaler"}]
